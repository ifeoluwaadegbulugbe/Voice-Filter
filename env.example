# Copy this file to .env and fill in your values.

# ── SERVER ───────────────────────────────────────────────────────────
PORT=8000
MODEL_PATH=checkpoints/best_model.pth

# ── PIPELINE STAGE TOGGLES (true = enabled) ──────────────────────────
ENABLE_SOX=true
ENABLE_NOISEREDUCE=true
ENABLE_SB_ENHANCE=true
ENABLE_SB_ENCODER=false
ENABLE_PYANNOTE=false
ENABLE_DEMUCS=false

# ── AUDIO SETTINGS ───────────────────────────────────────────────────
TARGET_SR=16000
STFT_N_FFT=512
STFT_HOP=128

# ── HUGGING FACE TOKEN (only required if ENABLE_PYANNOTE=true) ───────
# Get one free at: https://huggingface.co/settings/tokens
# Accept the model conditions at:
# https://huggingface.co/pyannote/voice-activity-detection
HF_TOKEN=hf_YOUR_TOKEN_HERE
